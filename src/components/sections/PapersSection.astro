---
import type { CollectionEntry } from 'astro:content';
import { Card, Link } from '@heroui/react';

import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  papers: CollectionEntry<'papers'>[];
  showAcceptedPapers: boolean;
}

const { papers, showAcceptedPapers } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const paperCount = papers.length;
const paperFileUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---

<section class="space-y-5">
  <SectionHeading
    eyebrow="Accepted papers"
    title="Accepted papers"
    description={showAcceptedPapers
      ? `${paperCount} papers were accepted to TPM 2026.`
      : 'The final accepted papers list will be published here once the review process is complete.'}
  />
  {
    showAcceptedPapers ? (
      <div class="grid items-stretch gap-4 md:grid-cols-2">
        {papers.map(paper => (
          <Card className="h-full" role="article">
            <Card.Header>
              <Card.Title>{paper.data.title}</Card.Title>
              <Card.Description>{paper.data.authors}</Card.Description>
            </Card.Header>
            <Card.Footer className="mt-auto flex flex-wrap items-center gap-4 text-sm">
              {paper.data.pdfUrl ? (
                <Link href={paperFileUrl(paper.data.pdfUrl)} target="_blank">
                  Read PDF
                </Link>
              ) : null}
              {paper.data.forumUrl ? (
                <Link href={paper.data.forumUrl} rel="noopener noreferrer" target="_blank">
                  OpenReview
                  <Link.Icon aria-hidden="true" />
                </Link>
              ) : null}
            </Card.Footer>
          </Card>
        ))}
      </div>
    ) : (
      <Card variant="default">
        <Card.Content className="space-y-3 text-sm leading-6 text-muted">
          <p>Will be published after acceptance.</p>
        </Card.Content>
      </Card>
    )
  }
</section>
